      <front_right_joint>joint_FR</front_right_joint>
      <back_left_joint>joint_BL</back_left_joint>
      <back_right_joint>joint_BR</back_right_joint>
      <wheel_separation>0.72</wheel_separation>
      <wheelbase>0.72</wheelbase>
      <wheel_radius>0.12</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
